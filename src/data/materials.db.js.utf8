function createMaterial(code, type) {
    let price = 0;
    let sizeLabel = "";
    let packing = "";
    let category = "";

    // Mapping logic
    if (type === "600") {
        price = 26000;
        sizeLabel = "600x600mm";
        packing = "9pcs / 3.24㎡";
        category = "600각";
    } else if (type === "450") {
        price = 25000;
        sizeLabel = "457.2x457.2mm";
        packing = "16pcs / 3.34㎡";
        category = "450각";
    } else if (type === "wood") {
        price = 25000;
        sizeLabel = "184x950mm";
        packing = "19pcs / 3.32㎡";
    }
    category = "데코타일";

    return {
        id: code,
        name: code,
        code: code,
        brand: "KCC",
        category: category,
        type: type,
        price: price,
        sizeLabel: sizeLabel,
        packing: packing,
        thickness: "3.0mm",
        isRecommended: code.includes("5541") || code.includes("5535") || code.includes("5104"),
        specs: {
            thickness: "3.0mm",
            size: sizeLabel,
            packing: packing
        }
    };
}

// Generate Lists
const matWood = LIST_WOOD.map(code => createMaterial(code, "wood"));

const matKccExtended = LIST_KCC_EXTENDED.map(item => {
    const base = createMaterial(item.code, item.type);
    return { ...base, id: item.id, name: item.name };
});

