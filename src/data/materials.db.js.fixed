const processDongshinItem = (item) => {
    let price = 36000; // Fixed price for all Dongshin
    let sizeLabel = "";
    let packing = "";
    let type = "";
    let category = "";

    const code = item.code;

    // Classification Logic
    // 1. Dongshin 450: specs.size 457.2x457.2mm, starts with AS
    if (code.startsWith("AS") || code.startsWith("AS_")) {
        sizeLabel = "457.2x457.2mm";
        packing = "16pcs / 3.34??;
        type = "ds_450";
        category = "?숈떊 450媛?;
    }
    // 3. Dongshin 600: specs.size 600x600mm, code AH 61**
    // Using startsWith("AH 61") or "AH_61" to be safe with formats
    else if (code.startsWith("AH 61") || code.startsWith("AH_61") || code.startsWith("AH61")) {
        sizeLabel = "600x600mm";
        packing = "9pcs / 3.24??;
        type = "ds_600";
        category = "?숈떊 600媛?;
    }
    // 2. Dongshin Wood: specs.size 180x920mm, starts with AB or AH 5/7
    else if (
        code.startsWith("AB") || code.startsWith("AB_") ||
        code.startsWith("AH 5") || code.startsWith("AH_5") || code.startsWith("AH5") ||
        code.startsWith("AH 7") || code.startsWith("AH_7") || code.startsWith("AH7")
    ) {
        sizeLabel = "180x920mm";
        packing = "20pcs / 3.31??;
        type = "ds_wood";
        category = "?숈떊 ?곕뱶";
    }
    // Fallback for unknown Dongshin codes
    else {
        sizeLabel = "180x920mm";
        packing = "20pcs / 3.31??;
        type = "ds_wood";
    }

    category = "?곗퐫???; // All current Dongshin items are also Deco Tile

    return {
        ...item,
        price,
        type,
        category,
        sizeLabel,
        packing,
        specs: {
            thickness: "3.0mm",
            size: sizeLabel,
            packing: packing
        }
    };
};

const LIST_DONGSHIN = LIST_DONGSHIN_RAW.map(processDongshinItem);

