function createMaterial(code, type) {
    let name = code; // Default name is code
    let price = 0;
    let sizeLabel = "";
    let packing = "";
    let category = "";

    // Mapping logic
    if (type === "600") {
        price = 26000;
        sizeLabel = "600x600mm";
        packing = "9pcs / 3.24??;
        category = "600媛?;
    } else if (type === "450") {
        price = 25000;
        sizeLabel = "457.2x457.2mm"; // Size label kept as is per usual product specs, just category name changed
        packing = "16pcs / 3.34??;
        category = "450媛?;
    } else if (type === "wood") {
        price = 25000;
        sizeLabel = "184x950mm";
        packing = "19pcs / 3.32??;
    }
    category = "?곗퐫???; // All current items are Deco Tile

    // Try to find a cleaner name if possible or just use code
    // In a real app, we might have a name map. For now, we use the code as the name base.
    // Ensure image path logic handles variants if they existed in the old file, 
    // but here we likely just stick to the base code for the main image.
    // Note: The user provided codes like "TS 5549P" but file might be "TS 5549P ?뚮뱶?ㅽ넠.jpg"
    // We might need to fuzzy match or just assume standard jpg. 
    // Given the previous file list, we should probably append naming if we knew it.
    // For this refactor, I will leave the name as the code to ensure it works, 
    // or try to preserve the existing names if I can match them.

    return {
        id: code,
        name: code,
        code: code,
        brand: "KCC",
        category: category,
        type: type,
        price: price,
        sizeLabel: sizeLabel,
        packing: packing,
        thickness: "3.0mm",
        isRecommended: code.includes("5541") || code.includes("5535") || code.includes("5104"),
        specs: {
            thickness: "3.0mm",
            size: sizeLabel,
            packing: packing
        }
    };
}

// Generate Lists
const mat600 = LIST_600.map(code => createMaterial(code, "600"));
const mat450 = LIST_450.map(code => createMaterial(code, "450"));
const matWood = LIST_WOOD.map(code => createMaterial(code, "wood"));

const matKccExtended = LIST_KCC_EXTENDED.map(item => {
    const base = createMaterial(item.code, item.type);
    return { ...base, id: item.id, name: item.name };
});

